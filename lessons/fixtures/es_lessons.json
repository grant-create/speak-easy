  {"model": "lessons.phrase", "pk": 1, "fields": {"lesson": 1, "original": "Yo quiero agua.", "translation": "I want water.", "example": "Subject + verb + noun. Spanish often drops the subject: 'Quiero agua.' works too.", "order": 1}},
  {"model": "lessons.phrase", "pk": 2, "fields": {"lesson": 1, "original": "¿Hablas inglés?", "translation": "Do you speak English?", "example": "Questions are formed by inverting tone or adding ¿? — word order stays the same.", "order": 2}},
  {"model": "lessons.phrase", "pk": 3, "fields": {"lesson": 1, "original": "No entiendo.", "translation": "I don't understand.", "example": "Add 'no' before the verb to make it negative.", "order": 3}},

  {"model": "lessons.phrase", "pk": 4, "fields": {"lesson": 2, "original": "Hola", "translation": "Hello", "example": "Used any time of day.", "order": 1}},
  {"model": "lessons.phrase", "pk": 5, "fields": {"lesson": 2, "original": "Adiós", "translation": "Goodbye", "example": "Also: 'Hasta luego' (see you later).", "order": 2}},
  {"model": "lessons.phrase", "pk": 6, "fields": {"lesson": 2, "original": "Por favor", "translation": "Please", "example": "Goes at the end: '¿Me das agua, por favor?'", "order": 3}},
  {"model": "lessons.phrase", "pk": 7, "fields": {"lesson": 2, "original": "Gracias", "translation": "Thank you", "example": "Response: 'De nada' (you're welcome).", "order": 4}},
  {"model": "lessons.phrase", "pk": 8, "fields": {"lesson": 2, "original": "¿Cómo estás?", "translation": "How are you?", "example": "Informal. Formal version: '¿Cómo está usted?'", "order": 5}},
  {"model": "lessons.phrase", "pk": 9, "fields": {"lesson": 2, "original": "Bien, ¿y tú?", "translation": "Good, and you?", "example": "Natural response to '¿Cómo estás?'", "order": 6}},
  {"model": "lessons.phrase", "pk": 10, "fields": {"lesson": 2, "original": "Perdón / Disculpe", "translation": "Excuse me / Sorry", "example": "'Perdón' for bumping into someone. 'Disculpe' to get attention.", "order": 7}},

  {"model": "lessons.phrase", "pk": 11, "fields": {"lesson": 3, "original": "esto / eso", "translation": "this / that", "example": "'Quiero esto.' (I want this.) 'Dame eso.' (Give me that.)", "order": 1}},
  {"model": "lessons.phrase", "pk": 12, "fields": {"lesson": 3, "original": "aquí / allí", "translation": "here / there", "example": "'Estoy aquí.' (I'm here.) 'Está allí.' (It's over there.)", "order": 2}},
  {"model": "lessons.phrase", "pk": 13, "fields": {"lesson": 3, "original": "este / ese", "translation": "this one / that one", "example": "'¿Cuánto cuesta este?' (How much is this one?)", "order": 3}},

  {"model": "lessons.phrase", "pk": 14, "fields": {"lesson": 4, "original": "ser / estar", "translation": "to be", "example": "'Soy americano.' (I am American.) 'Estoy cansado.' (I am tired.)", "order": 1}},
  {"model": "lessons.phrase", "pk": 15, "fields": {"lesson": 4, "original": "tener", "translation": "to have", "example": "'Tengo hambre.' (I'm hungry — lit. I have hunger.)", "order": 2}},
  {"model": "lessons.phrase", "pk": 16, "fields": {"lesson": 4, "original": "querer", "translation": "to want", "example": "'Quiero un café.' (I want a coffee.)", "order": 3}},
  {"model": "lessons.phrase", "pk": 17, "fields": {"lesson": 4, "original": "gustar", "translation": "to like", "example": "'Me gusta esto.' (I like this.) Note: subject and object flip in Spanish.", "order": 4}},
  {"model": "lessons.phrase", "pk": 18, "fields": {"lesson": 4, "original": "saber / conocer", "translation": "to know", "example": "'Sé hablar español.' (I know how to speak Spanish.) 'Conozco Madrid.' (I know Madrid.)", "order": 5}},
  {"model": "lessons.phrase", "pk": 19, "fields": {"lesson": 4, "original": "ir", "translation": "to go", "example": "'Voy al hotel.' (I'm going to the hotel.)", "order": 6}},

  {"model": "lessons.phrase", "pk": 20, "fields": {"lesson": 5, "original": "Quisiera...", "translation": "I would like...", "example": "'Quisiera una mesa, por favor.' (I'd like a table, please.)", "order": 1}},
  {"model": "lessons.phrase", "pk": 21, "fields": {"lesson": 5, "original": "¿Me puede dar...?", "translation": "Can you give me...?", "example": "'¿Me puede dar la cuenta?' (Can you give me the bill?)", "order": 2}},
  {"model": "lessons.phrase", "pk": 22, "fields": {"lesson": 5, "original": "¿Dónde está...?", "translation": "Where is...?", "example": "'¿Dónde está el baño?' (Where is the bathroom?)", "order": 3}},
  {"model": "lessons.phrase", "pk": 23, "fields": {"lesson": 5, "original": "¿Tiene...?", "translation": "Do you have...?", "example": "'¿Tiene habitaciones libres?' (Do you have rooms available?)", "order": 4}},
  {"model": "lessons.phrase", "pk": 24, "fields": {"lesson": 5, "original": "¿Cómo se dice...?", "translation": "How do you say...?", "example": "'¿Cómo se dice 'thank you'?' (How do you say 'thank you'?)", "order": 5}},

  {"model": "lessons.phrase", "pk": 25, "fields": {"lesson": 6, "original": "No entiendo.", "translation": "I don't understand.", "example": "Say this and people will usually slow down or rephrase.", "order": 1}},
  {"model": "lessons.phrase", "pk": 26, "fields": {"lesson": 6, "original": "¿Puede repetir?", "translation": "Can you repeat that?", "example": "Polite. Works in any situation.", "order": 2}},
  {"model": "lessons.phrase", "pk": 27, "fields": {"lesson": 6, "original": "Más despacio, por favor.", "translation": "Slower, please.", "example": "Essential for real conversations early on.", "order": 3}},
  {"model": "lessons.phrase", "pk": 28, "fields": {"lesson": 6, "original": "¿Qué significa esto?", "translation": "What does this mean?", "example": "Point at a word or sign and ask.", "order": 4}},
  {"model": "lessons.phrase", "pk": 29, "fields": {"lesson": 6, "original": "¿Me puede ayudar?", "translation": "Can you help me?", "example": "Universally understood and appreciated.", "order": 5}}
]
