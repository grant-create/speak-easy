  {"model": "lessons.phrase", "pk": 116, "fields": {"lesson": 25, "original": "Voglio dell'acqua.", "pronunciation": "VOL-yoh del-AH-kwah", "translation": "I want water.", "example": "Italian often drops the subject: 'Voglio' alone means 'I want'. Very natural.", "order": 1}},
  {"model": "lessons.phrase", "pk": 117, "fields": {"lesson": 25, "original": "Parla inglese?", "pronunciation": "PAR-lah een-GLAY-zeh", "translation": "Do you speak English?", "example": "Formal 'Lei' form used here. To a friend: 'Parli inglese?'", "order": 2}},
  {"model": "lessons.phrase", "pk": 118, "fields": {"lesson": 25, "original": "Non capisco.", "pronunciation": "non kah-PEES-koh", "translation": "I don't understand.", "example": "Place 'non' before the verb to negate. Simple and reliable.", "order": 3}},

  {"model": "lessons.phrase", "pk": 119, "fields": {"lesson": 26, "original": "Ciao / Buongiorno", "pronunciation": "CHOW / bwon-JOR-noh", "translation": "Hi / Good day", "example": "'Ciao' is casual (hello and goodbye). 'Buongiorno' is formal, used until afternoon.", "order": 1}},
  {"model": "lessons.phrase", "pk": 120, "fields": {"lesson": 26, "original": "Arrivederci", "pronunciation": "ah-ree-veh-DER-chee", "translation": "Goodbye", "example": "Formal. Casual: 'Ciao' or 'A presto' (see you soon).", "order": 2}},
  {"model": "lessons.phrase", "pk": 121, "fields": {"lesson": 26, "original": "Per favore", "pronunciation": "per fah-VOH-reh", "translation": "Please", "example": "Goes at the end: 'Un caffè, per favore.' Also: 'Per piacere'.", "order": 3}},
  {"model": "lessons.phrase", "pk": 122, "fields": {"lesson": 26, "original": "Grazie", "pronunciation": "GRAH-tsyeh", "translation": "Thank you", "example": "Response: 'Prego' (you're welcome). 'Grazie mille' = thank you very much.", "order": 4}},
  {"model": "lessons.phrase", "pk": 123, "fields": {"lesson": 26, "original": "Come sta?", "pronunciation": "KOH-meh stah", "translation": "How are you? (formal)", "example": "Casual: 'Come stai?' Response: 'Bene, grazie.' (Fine, thanks.)", "order": 5}},
  {"model": "lessons.phrase", "pk": 124, "fields": {"lesson": 26, "original": "Bene, grazie.", "pronunciation": "BEH-neh, GRAH-tsyeh", "translation": "Fine, thank you.", "example": "Add 'E Lei?' (And you? — formal) or 'E tu?' (casual).", "order": 6}},
  {"model": "lessons.phrase", "pk": 125, "fields": {"lesson": 26, "original": "Scusi", "pronunciation": "SKOO-zee", "translation": "Excuse me (formal)", "example": "Use 'Scusa' with friends. Invaluable for getting past people in Italy.", "order": 7}},

  {"model": "lessons.phrase", "pk": 126, "fields": {"lesson": 27, "original": "questo / quello", "pronunciation": "KWES-toh / KWEL-loh", "translation": "this / that", "example": "'Voglio questo.' (I want this.) Changes with gender: questa/quella for feminine.", "order": 1}},
  {"model": "lessons.phrase", "pk": 127, "fields": {"lesson": 27, "original": "qui / là", "pronunciation": "kwee / lah", "translation": "here / there", "example": "'Sono qui.' (I'm here.) 'È là.' (It's there.)", "order": 2}},
  {"model": "lessons.phrase", "pk": 128, "fields": {"lesson": 27, "original": "questo qui / quello là", "pronunciation": "KWES-toh kwee / KWEL-loh lah", "translation": "this one / that one", "example": "'Prendo questo qui.' (I'll take this one.)", "order": 3}},

  {"model": "lessons.phrase", "pk": 129, "fields": {"lesson": 28, "original": "essere", "pronunciation": "ES-seh-reh", "translation": "to be", "example": "'Sono stanco.' (I am tired.) 'È un buon ristorante.' (It's a good restaurant.)", "order": 1}},
  {"model": "lessons.phrase", "pk": 130, "fields": {"lesson": 28, "original": "avere", "pronunciation": "ah-VEH-reh", "translation": "to have", "example": "'Ho fame.' (I'm hungry — lit. I have hunger.)", "order": 2}},
  {"model": "lessons.phrase", "pk": 131, "fields": {"lesson": 28, "original": "volere", "pronunciation": "voh-LEH-reh", "translation": "to want", "example": "'Voglio un caffè.' (I want a coffee.) Polite: 'Vorrei...' (I would like...)", "order": 3}},
  {"model": "lessons.phrase", "pk": 132, "fields": {"lesson": 28, "original": "piacere", "pronunciation": "pyah-CHEH-reh", "translation": "to like (lit. to please)", "example": "'Mi piace questo.' (I like this — lit. this pleases me.) Subject and object flip, like Spanish 'gustar'.", "order": 4}},
  {"model": "lessons.phrase", "pk": 133, "fields": {"lesson": 28, "original": "sapere / conoscere", "pronunciation": "sah-PEH-reh / koh-NOH-sheh-reh", "translation": "to know", "example": "'So parlare italiano.' (I know how to speak Italian.) 'Conosco Roma.' (I know Rome.)", "order": 5}},
  {"model": "lessons.phrase", "pk": 134, "fields": {"lesson": 28, "original": "andare", "pronunciation": "ahn-DAH-reh", "translation": "to go", "example": "'Vado all'hotel.' (I'm going to the hotel.)", "order": 6}},

  {"model": "lessons.phrase", "pk": 135, "fields": {"lesson": 29, "original": "Vorrei...", "pronunciation": "vor-RAY", "translation": "I would like...", "example": "'Vorrei un tavolo, per favore.' (I'd like a table, please.) Softer than 'voglio'.", "order": 1}},
  {"model": "lessons.phrase", "pk": 136, "fields": {"lesson": 29, "original": "Può darmi...?", "pronunciation": "pwoh DAR-mee", "translation": "Can you give me...?", "example": "'Può darmi il conto?' (Can you give me the bill?)", "order": 2}},
  {"model": "lessons.phrase", "pk": 137, "fields": {"lesson": 29, "original": "Dov'è...?", "pronunciation": "doh-VEH", "translation": "Where is...?", "example": "'Dov'è il bagno?' (Where is the bathroom?)", "order": 3}},
  {"model": "lessons.phrase", "pk": 138, "fields": {"lesson": 29, "original": "Ha...?", "pronunciation": "ah", "translation": "Do you have...?", "example": "'Ha camere libere?' (Do you have free rooms?)", "order": 4}},
  {"model": "lessons.phrase", "pk": 139, "fields": {"lesson": 29, "original": "Come si dice...?", "pronunciation": "KOH-meh see DEE-cheh", "translation": "How do you say...?", "example": "'Come si dice 'thank you' in italiano?'", "order": 5}},

  {"model": "lessons.phrase", "pk": 140, "fields": {"lesson": 30, "original": "Non capisco.", "pronunciation": "non kah-PEES-koh", "translation": "I don't understand.", "example": "Italians are warm and will usually help you out.", "order": 1}},
  {"model": "lessons.phrase", "pk": 141, "fields": {"lesson": 30, "original": "Può ripetere?", "pronunciation": "pwoh ree-PEH-teh-reh", "translation": "Can you repeat that?", "example": "Formal. Casual: 'Puoi ripetere?'", "order": 2}},
  {"model": "lessons.phrase", "pk": 142, "fields": {"lesson": 30, "original": "Più lentamente, per favore.", "pronunciation": "pyoo len-tah-MEN-teh, per fah-VOH-reh", "translation": "Slower, please.", "example": "Italian spoken quickly can be hard to follow at first.", "order": 3}},
  {"model": "lessons.phrase", "pk": 143, "fields": {"lesson": 30, "original": "Cosa significa?", "pronunciation": "KOH-zah seen-YEE-fee-kah", "translation": "What does this mean?", "example": "Point at a word or sign.", "order": 4}},
  {"model": "lessons.phrase", "pk": 144, "fields": {"lesson": 30, "original": "Può aiutarmi?", "pronunciation": "pwoh ah-yoo-TAR-mee", "translation": "Can you help me?", "example": "Italians are generally very willing to help.", "order": 5}}
]
