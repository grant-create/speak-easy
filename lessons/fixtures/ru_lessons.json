  {"model": "lessons.phrase", "pk": 290, "fields": {"lesson": 61, "original": "Я хочу воды.", "pronunciation": "ya kha-CHOO va-DI", "translation": "I want water.", "example": "Word order is flexible in Russian. 'Воды' is genitive — Russian uses cases to show relationships between words.", "order": 1}},
  {"model": "lessons.phrase", "pk": 291, "fields": {"lesson": 61, "original": "Вы говорите по-английски?", "pronunciation": "vi ga-va-REE-tye pa ang-LEES-ki", "translation": "Do you speak English?", "example": "Formal 'Вы'. Casual (to a friend): 'Ты говоришь по-английски? (ti ga-va-REESH)'.", "order": 2}},
  {"model": "lessons.phrase", "pk": 292, "fields": {"lesson": 61, "original": "Я не понимаю.", "pronunciation": "ya nye pa-ni-MAH-yu", "translation": "I don't understand.", "example": "'Не (nye)' = not. Place before the verb to negate.", "order": 3}},

  {"model": "lessons.phrase", "pk": 293, "fields": {"lesson": 62, "original": "Привет / Здравствуйте", "pronunciation": "pri-VYET / ZDRAS-tvuy-tye", "translation": "Hi / Hello (formal)", "example": "'Привет' is casual. 'Здравствуйте' is formal — the 'в' in the middle is often silent: 'ZDRAStvuytye'.", "order": 1}},
  {"model": "lessons.phrase", "pk": 294, "fields": {"lesson": 62, "original": "До свидания", "pronunciation": "da svi-DAH-nya", "translation": "Goodbye", "example": "Casual: 'Пока (pa-KAH)' — bye. Or 'До встречи (da VSTRYEH-chi)' — see you soon.", "order": 2}},
  {"model": "lessons.phrase", "pk": 295, "fields": {"lesson": 62, "original": "Пожалуйста", "pronunciation": "pa-ZHAHL-sta", "translation": "Please / You're welcome", "example": "Like German 'bitte', works for both. The middle syllable is often swallowed: 'pa-ZHAL-sta'.", "order": 3}},
  {"model": "lessons.phrase", "pk": 296, "fields": {"lesson": 62, "original": "Спасибо", "pronunciation": "spa-SEE-ba", "translation": "Thank you", "example": "Response: 'Пожалуйста' or 'Не за что (NYE za shto)' — don't mention it.", "order": 4}},
  {"model": "lessons.phrase", "pk": 297, "fields": {"lesson": 62, "original": "Как дела?", "pronunciation": "kak dye-LAH", "translation": "How are things? / How are you?", "example": "Lit. 'how are affairs?' Response: 'Хорошо, спасибо. (kha-ra-SHOH)' — Good, thanks.", "order": 5}},
  {"model": "lessons.phrase", "pk": 298, "fields": {"lesson": 62, "original": "Хорошо, спасибо.", "pronunciation": "kha-ra-SHOH, spa-SEE-ba", "translation": "Good, thank you.", "example": "Add 'А у вас? (a oo vahs?)' — And you? (formal) — to be polite.", "order": 6}},
  {"model": "lessons.phrase", "pk": 299, "fields": {"lesson": 62, "original": "Извините", "pronunciation": "iz-vi-NEE-tye", "translation": "Excuse me / Sorry (formal)", "example": "Casual: 'Прости (pra-STI)'. Use 'Извините' when speaking to strangers.", "order": 7}},

  {"model": "lessons.phrase", "pk": 300, "fields": {"lesson": 63, "original": "это / то", "pronunciation": "EH-ta / toh", "translation": "this / that", "example": "'Это что? (EH-ta shto?)' — What is this? 'Это' is one of the most useful words in Russian.", "order": 1}},
  {"model": "lessons.phrase", "pk": 301, "fields": {"lesson": 63, "original": "здесь / там", "pronunciation": "zdyes / tahm", "translation": "here / there", "example": "'Я здесь.' (I'm here.) 'Это там.' (It's there.)", "order": 2}},
  {"model": "lessons.phrase", "pk": 302, "fields": {"lesson": 63, "original": "этот / тот", "pronunciation": "EH-tat / toht", "translation": "this one / that one", "example": "'Я хочу этот.' (I want this one.) Changes with gender: эта/та (fem), это/то (neut).", "order": 3}},

  {"model": "lessons.phrase", "pk": 303, "fields": {"lesson": 64, "original": "быть", "pronunciation": "bit'", "translation": "to be", "example": "Russian drops 'to be' in the present tense: 'Я студент.' (I am a student.) No verb needed.", "order": 1}},
  {"model": "lessons.phrase", "pk": 304, "fields": {"lesson": 64, "original": "у меня есть", "pronunciation": "oo mye-NYA yest'", "translation": "to have (lit. at me there is)", "example": "'У меня есть вода.' (I have water.) Russian expresses possession differently to English.", "order": 2}},
  {"model": "lessons.phrase", "pk": 305, "fields": {"lesson": 64, "original": "хотеть", "pronunciation": "kha-TYET'", "translation": "to want", "example": "'Я хочу кофе.' (I want coffee.) Softer: 'Я бы хотел (ya bi kha-TYEL)' — I would like.", "order": 3}},
  {"model": "lessons.phrase", "pk": 306, "fields": {"lesson": 64, "original": "нравиться / любить", "pronunciation": "NRAH-vi-tsya / lyu-BEET'", "translation": "to like / to love", "example": "'Мне нравится это.' (I like this — lit. this is pleasing to me.) 'любить' is stronger.", "order": 4}},
  {"model": "lessons.phrase", "pk": 307, "fields": {"lesson": 64, "original": "знать", "pronunciation": "znat'", "translation": "to know", "example": "'Я знаю.' (I know.) 'Я не знаю.' (I don't know.) Very frequently used.", "order": 5}},
  {"model": "lessons.phrase", "pk": 308, "fields": {"lesson": 64, "original": "идти / ехать", "pronunciation": "id-TEE / YEH-khat'", "translation": "to go (on foot / by vehicle)", "example": "'Я иду в гостиницу.' (I'm walking to the hotel.) 'Я еду в Москву.' (I'm going to Moscow by vehicle.)", "order": 6}},

  {"model": "lessons.phrase", "pk": 309, "fields": {"lesson": 65, "original": "Я бы хотел(а)...", "pronunciation": "ya bi kha-TYEL / kha-TYER-la", "translation": "I would like...", "example": "Men say 'хотел', women say 'хотела'. '...пожалуйста' at the end softens it further.", "order": 1}},
  {"model": "lessons.phrase", "pk": 310, "fields": {"lesson": 65, "original": "Вы можете дать мне...?", "pronunciation": "vi MOH-zheh-tye dat' mnye", "translation": "Can you give me...?", "example": "'Вы можете дать мне счёт?' (Can you give me the bill?)", "order": 2}},
  {"model": "lessons.phrase", "pk": 311, "fields": {"lesson": 65, "original": "Где...?", "pronunciation": "gdye", "translation": "Where is...?", "example": "'Где туалет?' (Where is the toilet?) Short, clear, works everywhere.", "order": 3}},
  {"model": "lessons.phrase", "pk": 312, "fields": {"lesson": 65, "original": "У вас есть...?", "pronunciation": "oo vahs yest'", "translation": "Do you have...?", "example": "'У вас есть свободные номера?' (Do you have free rooms?)", "order": 4}},
  {"model": "lessons.phrase", "pk": 313, "fields": {"lesson": 65, "original": "Как будет...по-русски?", "pronunciation": "kak BOO-dyet ... pa-ROOS-ki", "translation": "How do you say ... in Russian?", "example": "Lit. 'How will ... be in Russian?'", "order": 5}},

  {"model": "lessons.phrase", "pk": 314, "fields": {"lesson": 66, "original": "Я не понимаю.", "pronunciation": "ya nye pa-ni-MAH-yu", "translation": "I don't understand.", "example": "Russians respect any effort to speak Russian — say this freely.", "order": 1}},
  {"model": "lessons.phrase", "pk": 315, "fields": {"lesson": 66, "original": "Повторите, пожалуйста.", "pronunciation": "pav-ta-REE-tye, pa-ZHAHL-sta", "translation": "Please repeat that.", "example": "Formal and polite.", "order": 2}},
  {"model": "lessons.phrase", "pk": 316, "fields": {"lesson": 66, "original": "Говорите медленнее, пожалуйста.", "pronunciation": "ga-va-REE-tye MYED-len-nye-ye, pa-ZHAHL-sta", "translation": "Please speak more slowly.", "example": "Russian spoken at native speed can be very fast.", "order": 3}},
  {"model": "lessons.phrase", "pk": 317, "fields": {"lesson": 66, "original": "Что это значит?", "pronunciation": "shto EH-ta ZNAH-chit", "translation": "What does this mean?", "example": "Point at a word, sign, or Cyrillic text.", "order": 4}},
  {"model": "lessons.phrase", "pk": 318, "fields": {"lesson": 66, "original": "Вы можете мне помочь?", "pronunciation": "vi MOH-zheh-tye mnye pa-MOHCH'", "translation": "Can you help me?", "example": "Polite and well received.", "order": 5}}
