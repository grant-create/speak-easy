  {"model": "lessons.phrase", "pk": 203, "fields": {"lesson": 43, "original": "我要水。", "pronunciation": "wǒ yào shuǐ", "translation": "I want water.", "example": "Word order is Subject-Verb-Object, like English. No verb conjugation — 'yào' always means 'want'.", "order": 1}},
  {"model": "lessons.phrase", "pk": 204, "fields": {"lesson": 43, "original": "你说英语吗？", "pronunciation": "nǐ shuō yīng-yǔ ma", "translation": "Do you speak English?", "example": "Add '吗 (ma)' to the end of any statement to make it a yes/no question.", "order": 2}},
  {"model": "lessons.phrase", "pk": 205, "fields": {"lesson": 43, "original": "我不明白。", "pronunciation": "wǒ bù míng-bái", "translation": "I don't understand.", "example": "'不 (bù)' = not. Place it before the verb to negate. Tone: 'bù' drops to 2nd tone before 4th tone syllables.", "order": 3}},

  {"model": "lessons.phrase", "pk": 206, "fields": {"lesson": 44, "original": "你好", "pronunciation": "nǐ hǎo", "translation": "Hello", "example": "Lit. 'you good'. Formal/respectful: '您好 (nín hǎo)'. Response: same back.", "order": 1}},
  {"model": "lessons.phrase", "pk": 207, "fields": {"lesson": 44, "original": "再见", "pronunciation": "zài jiàn", "translation": "Goodbye", "example": "Lit. 'again see'. Casual: '拜拜 (bài bài)' from English 'bye bye'.", "order": 2}},
  {"model": "lessons.phrase", "pk": 208, "fields": {"lesson": 44, "original": "请", "pronunciation": "qǐng", "translation": "Please", "example": "Goes before the verb: '请给我...' (Please give me...). Also means 'invite'.", "order": 3}},
  {"model": "lessons.phrase", "pk": 209, "fields": {"lesson": 44, "original": "谢谢", "pronunciation": "xiè xie", "translation": "Thank you", "example": "Response: '不客气 (bù kè qi)' — you're welcome. '谢谢你 (xiè xie nǐ)' is slightly more personal.", "order": 4}},
  {"model": "lessons.phrase", "pk": 210, "fields": {"lesson": 44, "original": "你好吗？", "pronunciation": "nǐ hǎo ma", "translation": "How are you?", "example": "Lit. 'you good?'. In casual speech people often skip this and jump to '吃了吗？(chī le ma)' — have you eaten?", "order": 5}},
  {"model": "lessons.phrase", "pk": 211, "fields": {"lesson": 44, "original": "我很好，谢谢。", "pronunciation": "wǒ hěn hǎo, xiè xie", "translation": "I'm very good, thank you.", "example": "'很 (hěn)' = very. Without it, the sentence sounds like you're just 'okay'. '你呢？(nǐ ne?)' = And you?", "order": 6}},
  {"model": "lessons.phrase", "pk": 212, "fields": {"lesson": 44, "original": "对不起 / 不好意思", "pronunciation": "duì bu qǐ / bù hǎo yì si", "translation": "Sorry / Excuse me", "example": "'对不起' for real apologies. '不好意思' for minor things — getting past someone, interrupting.", "order": 7}},

  {"model": "lessons.phrase", "pk": 213, "fields": {"lesson": 45, "original": "这个 / 那个", "pronunciation": "zhè ge / nà ge", "translation": "this (one) / that (one)", "example": "'我要这个。' (I want this one.) '个 (ge)' is the general measure word — the most common one.", "order": 1}},
  {"model": "lessons.phrase", "pk": 214, "fields": {"lesson": 45, "original": "这里 / 那里", "pronunciation": "zhè lǐ / nà lǐ", "translation": "here / there", "example": "'我在这里。' (I'm here.) Also: '这儿 (zhèr) / 那儿 (nàr)' in northern China.", "order": 2}},
  {"model": "lessons.phrase", "pk": 215, "fields": {"lesson": 45, "original": "这个 / 那个 (pointing)", "pronunciation": "zhè ge / nà ge", "translation": "this one / that one", "example": "Point and say '这个，谢谢。' (This one, thanks.) Works in any shop or restaurant.", "order": 3}},

  {"model": "lessons.phrase", "pk": 216, "fields": {"lesson": 46, "original": "是 / 在", "pronunciation": "shì / zài", "translation": "to be", "example": "'我是学生。' (I am a student.) '我在北京。' (I am in Beijing.) '是' for identity, '在' for location.", "order": 1}},
  {"model": "lessons.phrase", "pk": 217, "fields": {"lesson": 46, "original": "有", "pronunciation": "yǒu", "translation": "to have", "example": "'我有钱。' (I have money.) '有' also means 'there is/are': '这里有厕所吗？' (Is there a toilet here?)", "order": 2}},
  {"model": "lessons.phrase", "pk": 218, "fields": {"lesson": 46, "original": "想要", "pronunciation": "xiǎng yào", "translation": "to want", "example": "'我想要一杯咖啡。' (I want a cup of coffee.) '想' alone means 'to think/miss'.", "order": 3}},
  {"model": "lessons.phrase", "pk": 219, "fields": {"lesson": 46, "original": "喜欢", "pronunciation": "xǐ huān", "translation": "to like", "example": "'我喜欢中国菜。' (I like Chinese food.)", "order": 4}},
  {"model": "lessons.phrase", "pk": 220, "fields": {"lesson": 46, "original": "知道 / 认识", "pronunciation": "zhī dào / rèn shi", "translation": "to know", "example": "'我知道。' (I know — a fact.) '我认识他。' (I know him — personally.)", "order": 5}},
  {"model": "lessons.phrase", "pk": 221, "fields": {"lesson": 46, "original": "去", "pronunciation": "qù", "translation": "to go", "example": "'我去酒店。' (I'm going to the hotel.)", "order": 6}},

  {"model": "lessons.phrase", "pk": 222, "fields": {"lesson": 47, "original": "我想要...", "pronunciation": "wǒ xiǎng yào", "translation": "I would like...", "example": "'我想要一杯茶，谢谢。' (I'd like a cup of tea, thanks.)", "order": 1}},
  {"model": "lessons.phrase", "pk": 223, "fields": {"lesson": 47, "original": "能给我...吗？", "pronunciation": "néng gěi wǒ ... ma", "translation": "Can you give me...?", "example": "'能给我菜单吗？' (Can you give me the menu?)", "order": 2}},
  {"model": "lessons.phrase", "pk": 224, "fields": {"lesson": 47, "original": "...在哪里？", "pronunciation": "... zài nǎ lǐ", "translation": "Where is...?", "example": "'厕所在哪里？' (Where is the toilet?) One of the most useful phrases.", "order": 3}},
  {"model": "lessons.phrase", "pk": 225, "fields": {"lesson": 47, "original": "你有...吗？", "pronunciation": "nǐ yǒu ... ma", "translation": "Do you have...?", "example": "'你有英文菜单吗？' (Do you have an English menu?)", "order": 4}},
  {"model": "lessons.phrase", "pk": 226, "fields": {"lesson": 47, "original": "...用中文怎么说？", "pronunciation": "... yòng zhōng wén zěn me shuō", "translation": "How do you say ... in Chinese?", "example": "Point at something or say the English word first.", "order": 5}},

  {"model": "lessons.phrase", "pk": 227, "fields": {"lesson": 48, "original": "我不明白。", "pronunciation": "wǒ bù míng-bái", "translation": "I don't understand.", "example": "Chinese people are very patient with learners — say this freely.", "order": 1}},
  {"model": "lessons.phrase", "pk": 228, "fields": {"lesson": 48, "original": "能再说一遍吗？", "pronunciation": "néng zài shuō yī biàn ma", "translation": "Can you say that again?", "example": "Polite and natural.", "order": 2}},
  {"model": "lessons.phrase", "pk": 229, "fields": {"lesson": 48, "original": "请说慢一点。", "pronunciation": "qǐng shuō màn yī diǎn", "translation": "Please speak a bit slower.", "example": "Mandarin spoken at natural speed can be very fast. This always helps.", "order": 3}},
  {"model": "lessons.phrase", "pk": 230, "fields": {"lesson": 48, "original": "这是什么意思？", "pronunciation": "zhè shì shén me yì si", "translation": "What does this mean?", "example": "Point at text or a character you don't recognise.", "order": 4}},
  {"model": "lessons.phrase", "pk": 231, "fields": {"lesson": 48, "original": "你能帮我吗？", "pronunciation": "nǐ néng bāng wǒ ma", "translation": "Can you help me?", "example": "Helpful and polite. Often people will go out of their way to assist.", "order": 5}}
]
